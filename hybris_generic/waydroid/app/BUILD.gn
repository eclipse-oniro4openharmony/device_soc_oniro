#
# "Waydroid" — the OHOS front-end for Android apps: a grid of the container's
# apps, each opened in an ordinary OHOS window, plus the settings panel that
# manages the container itself (see README.md).  The bundle name and the hap
# file keep the org.oniroproject.androidapps / AndroidApps.hap spelling of the
# first version: the signing profile, the compositor's caller check and the
# supervisor's path to the images all name it.
#
# The HAP itself bundles no native code: what needs the inner samgr/surface
# APIs lives in the system NAPI module ../napi (requireNapi
# 'oniro.androidcontainer'), which an app's linker namespace does not apply
# to.  In-tree (not hvigor) so that it is signed and preinstalled with the
# image; the app and the compositor share a protocol and must match.
#
# OPT-IN like the rest of the container stack: only built with
# hybris_generic_soc_feature_waydroid.  X23 images are unaffected.

import("//build/ohos.gni")

ohos_hap("android_apps_hap") {
  hap_profile = "entry/src/main/module.json"
  hap_name = "AndroidApps"
  subsystem_name = "oniro_soc_products"
  part_name = "hybris_generic_soc"
  final_hap_path = "$root_out_dir/oniro_soc_products/hybris_generic_soc/AndroidApps.hap"
  deps = [
    ":android_apps_js_assets",
    ":android_apps_resources",
  ]
  certificate_profile = "signature/androidapps.p7b"
  module_install_dir = "app/org.oniroproject.androidapps"
}

ohos_app_scope("android_apps_app_profile") {
  app_profile = "AppScope/app.json"
  sources = [ "AppScope/resources" ]
}

ohos_js_assets("android_apps_js_assets") {
  ets2abc = true
  source_dir = "entry/src/main/ets"
}

ohos_resources("android_apps_resources") {
  sources = [ "entry/src/main/resources" ]
  deps = [ ":android_apps_app_profile" ]
  hap_profile = "entry/src/main/module.json"
}
