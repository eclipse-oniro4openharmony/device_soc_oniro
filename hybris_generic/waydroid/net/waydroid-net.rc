# W6 real networking (android_app_compat_plan.md §W6).
#
# waydroidd creates the wdb0<->eth0 veth pair, enables ip_forward,
# MASQUERADEs 192.168.240.0/24 out the active uplink, and runs a
# single-lease DHCP server on wdb0.  The image's ethernet stack DHCPs eth0
# and netd installs the default route + DNS into the per-network policy
# tables app traffic uses — that is the whole networking path.
#
# waydroid-net.sh is only a fallback: if DHCP produced no default route a
# few seconds after boot it re-applies the W4 static config (adbd reachable
# at 192.168.240.2, no internet).  It no-ops on the happy DHCP path.
#
# Deployed to the graft: /odm/etc/init/waydroid-net.rc + /odm/waydroid-net.sh.

service waydroid-net /system/bin/sh /odm/waydroid-net.sh
    user root
    oneshot
    disabled

on property:sys.boot_completed=1
    start waydroid-net
