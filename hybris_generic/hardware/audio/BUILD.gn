# Audio VDI plugin: the Android legacy audio HAL from the Halium vendor
# partition, driven in-process through libhybris.  Loaded by the upstream VDI
# dispatcher (libaudio_primary_impl_vdi.z.so), which the primary audio HDI
# service selects when ohos.audio.hdi_impl=vdi.  See
# device/board/oniro/docs/hybris_generic/audio_hal_switch_plan.md.

import("//build/ohos.gni")
import("//drivers/hdf_core/adapter/uhdf2/uhdf.gni")

group("audio_primary_model") {
  deps = [
    ":libaudio_primary_impl",
    ":mixerctl",
  ]
}

# Mixer CLI — the only way to see what the Android audio HAL did to the codec,
# since that HAL runs in-process through libhybris and its own logs cannot
# reach the container's logd.  Not installed; build and push it.
ohos_executable("mixerctl") {
  sources = [ "tools/mixerctl.c" ]
  install_enable = false
  subsystem_name = "oniro_soc_products"
  part_name = "hybris_generic_soc"
}

ohos_shared_library("libaudio_primary_impl") {
  sources = [
    "src/hybris_audio_adapter.cpp",
    "src/hybris_audio_capture.cpp",
    "src/hybris_audio_manager.cpp",
    "src/hybris_audio_render.cpp",
  ]

  include_dirs = [
    "include",
    "src",
    "//third_party/libhybris/hybris/include",
    "//third_party/android-headers",
    "//third_party/alsa-lib/include",
    "//drivers/peripheral/audio/interfaces/sound/v1_0",
  ]

  # No link-time dep on libhardware: deps_guard's Passthrough rule only permits
  # deps on other passthrough-tagged modules, and libhardware is system-tagged.
  # hybris_audio_manager.cpp dlopens /system/lib64/libhardware.z.so instead —
  # it is itself only a libhybris wrapper around the Android loader.
  deps = []

  external_deps = [
    "c_utils:utils",
    "hdf_core:libhdf_utils",
    "hilog:libhilog",
    "init:libbegetutil",
  ]

  defines = [
    "ANDROID_VERSION_MAJOR=12",
    "RTLD_LAZY=1",
  ]

  cflags_cc = [
    "-Wno-error=unused-function",
    "-Wno-error=missing-braces",
    "-Wno-error=#warnings",
    "-Wno-error=unused-parameter",
    "-Wno-error=unused-variable",
  ]

  # The dispatcher dlopens the bare /vendor/lib64/<name>.z.so path
  # (HDF_LIBRARY_FULL_PATH in vdi_src/audio_manager_vdi.c), so this must not
  # land in passthrough/.  The sensor and vibrator VDIs install to
  # /vendor/lib64/ without the tag; follow them.
  output_name = "libaudio_primary_impl"
  install_enable = true
  install_images = [ chipset_base_dir ]
  subsystem_name = "oniro_soc_products"
  part_name = "hybris_generic_soc"
}
