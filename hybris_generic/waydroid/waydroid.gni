declare_args() {
  # Android app support (the Waydroid container stack): compositor, container
  # launcher, supervisor, gralloc bridge and the Waydroid front-end.
  #
  # Off by default so that a product has to ask for it.  A product turns it on
  # from its config.json, together with the three things it depends on:
  #
  #   { "component": "hybris_generic_soc",
  #     "features": [ "hybris_generic_soc_feature_waydroid = true" ] },
  #   { "component": "libhybris",
  #     "features": [ "libhybris_enable_wayland = true" ] },
  #   { "component": "wayland",  "features": [] },
  #   { "component": "libffi",   "features": [] }
  #
  # With it off nothing of the stack is built or installed and the tree does
  # not need //third_party/wayland or //third_party/libffi at all.
  hybris_generic_soc_feature_waydroid = false
}
