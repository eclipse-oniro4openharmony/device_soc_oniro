# Bring the host's Mali AIDL allocator up inside the container so
# SurfaceFlinger can allocate GPU buffers (gralloc_bridge/README).
service vendor.waydroid-gralloc /system/bin/sh /odm/start-allocator.sh
    class hal
    user root
    group system graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger

# Switch the hwcomposer to full-UI mode once SF is definitely compositing
# (a real, non-NULL framebuffer-target exists), so it forwards frames to
# waydroid_compositor. Doing this earlier races the NULL FB-target crash.
on property:sys.boot_completed=1
    setprop waydroid.active_apps Waydroid
