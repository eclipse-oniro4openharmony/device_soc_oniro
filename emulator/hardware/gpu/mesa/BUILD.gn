import("//build/ohos.gni")

# Mesa (EGL/GLES on llvmpipe/virgl) built for each emulator architecture; see
# ../<target_cpu>/PROVENANCE.md for the source and the build recipe.
assert(target_cpu == "x86_64" || target_cpu == "arm64",
       "no Mesa prebuilt for target_cpu ${target_cpu}")
mesa_dir = "../${target_cpu}"

ohos_prebuilt_shared_library("mesa_egl") {
    source = "${mesa_dir}/libEGL.so.1.0.0"
    install_enable = true
    part_name = "emulator"
    install_images = [ vendor_base_dir ]
    relative_install_dir = "chipsetsdk"
    symlink_target_name = [
        "libEGL_impl.so",
    ]
}

ohos_prebuilt_shared_library("mesa_gbm") {
    source = "${mesa_dir}/libgbm.so.1.0.0"
    install_enable = true
    part_name = "emulator"
    install_images = [ vendor_base_dir ]
    relative_install_dir = "chipsetsdk"
    symlink_target_name = [
        "libgbm.so.1",
        "libgbm.so",
    ]
}

ohos_prebuilt_shared_library("mesa_glesv1") {
    source = "${mesa_dir}/libGLESv1_CM.so.1.1.0"
    install_enable = true
    part_name = "emulator"
    install_images = [ vendor_base_dir ]
    relative_install_dir = "chipsetsdk"
    symlink_target_name = [
        "libGLESv1_impl.so",
    ]
}

ohos_prebuilt_shared_library("mesa_glesv2") {
    source = "${mesa_dir}/libGLESv2.so.2.0.0"
    install_enable = true
    part_name = "emulator"
    install_images = [ vendor_base_dir ]
    relative_install_dir = "chipsetsdk"
    symlink_target_name = [
        "libGLESv2_impl.so",
        "libGLESv3_impl.so",
    ]
}

ohos_prebuilt_shared_library("libgallium_dri") {
    source = "${mesa_dir}/libgallium_dri.so"
    install_enable = true
    part_name = "emulator"
    install_images = [ vendor_base_dir ]
    relative_install_dir = "chipsetsdk"
    symlink_target_name = [
        "iris_dri.so",
        "crocus_dri.so",
        "radeonsi_dri.so",
        "nouveau_dri.so",
        "swrast_dri.so",
        "kms_swrast_dri.so",
        "virtio_gpu_dri.so",
    ]
}

group("mesa3d-lib") {
    deps = [
        ":mesa_egl",
        ":mesa_gbm",
        ":mesa_glesv1",
        ":mesa_glesv2",
        ":libgallium_dri",
    ]
}
