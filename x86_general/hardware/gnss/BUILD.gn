import("//build/ohos.gni")

group("gnss_emulator_group") {
  deps = [
    ":emulator_gnss_para",
    ":vendorGnssAdapter",
  ]
}

# Simulated GNSS receiver driven by emulator.gnss.location: see
# src/emulator_gnss_adapter.cpp. location_host dlopens it by the literal
# name "vendorGnssAdapter.so" from /vendor/lib64.
ohos_shared_library("vendorGnssAdapter") {
  sources = [ "src/emulator_gnss_adapter.cpp" ]

  include_dirs = [ "//drivers/peripheral/location/gnss/hdi_service" ]

  external_deps = [
    "hilog:libhilog",
    "init:libbegetutil",
  ]

  cflags = [
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  # The HDI dlcloses the library on CleanUp; keep it mapped so a session
  # thread can never run unmapped code.
  ldflags = [ "-Wl,-z,nodelete" ]

  output_name = "vendorGnssAdapter"
  output_prefix_override = true
  output_extension = "so"
  install_enable = true
  install_images = [ chipset_base_dir ]
  part_name = "x86_general"
}

# Default position, loaded by init from /vendor/etc/param.
ohos_prebuilt_etc("emulator_gnss_para") {
  source = "emulator_gnss.para"
  relative_install_dir = "param"
  install_images = [ chipset_base_dir ]
  part_name = "x86_general"
}
