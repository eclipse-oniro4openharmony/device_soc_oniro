# Replacement wifi_hal library for hybris_generic.
#
# Uses all upstream sources from drivers/peripheral/wlan/chip/wifi_hal/ except
# wifi_ioctl.cpp, which is replaced by our local version that stubs out the
# Huawei/HiSilicon vendor-specific ioctl (SIOCDEVPRIVATE+1) that crashes on
# MediaTek hardware.
#
# To use: set drivers_peripheral_wlan_feature_vendor = "hybris" in product config
# and add this target as a dependency.

import("//build/ohos.gni")

UPSTREAM_WIFI_HAL = "//drivers/peripheral/wlan/chip/wifi_hal"
UPSTREAM_HDI_SERVICE = "//drivers/peripheral/wlan/chip/hdi_service"

ohos_shared_library("wifi_hal_default") {
  include_dirs = [
    "${UPSTREAM_HDI_SERVICE}",
    "${UPSTREAM_WIFI_HAL}",
  ]

  sources = [
    # Upstream sources (unchanged)
    "${UPSTREAM_WIFI_HAL}/common.cpp",
    "${UPSTREAM_WIFI_HAL}/cpp_bindings.cpp",
    "${UPSTREAM_WIFI_HAL}/gscan.cpp",
    "${UPSTREAM_WIFI_HAL}/wifi_hal.cpp",
    "${UPSTREAM_WIFI_HAL}/wifi_logger.cpp",
    "${UPSTREAM_WIFI_HAL}/wifi_scan.cpp",

    # Our patched version (stubs vendor-specific ioctl for MediaTek)
    "wifi_ioctl.cpp",
  ]

  external_deps = [
    "c_utils:utils",
    "drivers_interface_wlan:chip_idl_headers_2.0",
    "hdf_core:libhdf_ipc_adapter",
    "hdf_core:libhdf_utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "libnl:libnl_share",
  ]

  install_images = [ chipset_base_dir ]
  subsystem_name = "oniro_soc_products"
  part_name = "hybris_generic_soc"
}

# The wlan "extend" VDI wlan_interface_service hard-requires at Init: without
# /vendor/lib64/libhdi_wlan_impl.z.so the whole base WLAN HDI never registers
# (HdfLoadVdi ENOENT -> WlanInterfaceServiceInit fails). The extend surface is
# vendor-private (channel meas, hid2d, raw ioctls) and the MediaTek/Halium
# stack has none of it, so every op reports NOT_SUPPORT.
ohos_shared_library("libhdi_wlan_impl") {
  sources = [ "hdi_wlan_impl.c" ]

  # Same set upstream's libwlan_service_extend uses: wifi_hal.h (interfaces)
  # pulls in wifi_hal_sta_feature.h, which needs wifi_driver_client.h from
  # client/include.
  include_dirs = [
    "//drivers/peripheral/wlan/hdi_service/service_extend/service_extend_vdi",
    "//drivers/peripheral/wlan/interfaces/include",
    "//drivers/peripheral/wlan/client/include",
    "//drivers/peripheral/wlan/hal/include",
  ]

  external_deps = [
    "drivers_interface_wlan:libwlan_stub_1.3",
    "hdf_core:libhdf_host",
    "hdf_core:libhdf_utils",
    "hilog:libhilog",
  ]

  cflags = [
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  install_enable = true
  install_images = [ chipset_base_dir ]
  output_name = "libhdi_wlan_impl"
  subsystem_name = "oniro_soc_products"
  part_name = "hybris_generic_soc"
}
