# Waydroid image pins: <name> <sha256>
#
# The two *.zip lines are what gets downloaded (by utils/host/waydroid-images.sh
# from a host, or by the Waydroid front-end on the device); the two *.img
# lines are what is inside them, and what waydroidd checks before it mounts
# anything — it refuses an image that is not listed here.  Bump all four
# together.
#
# base-url is the directory the zips live in: <base-url>/<zip>.
base-url https://volla.tech/filedump/waydroid-16

# system: lineage-23.0 (Android 16, SDK 36) VANILLA arm64-only.  EROFS, not
# ext4 — waydroidd picks the filesystem by superblock magic.
waydroid_arm64_only-system-20260908.zip c059f5e7618dc32127e24073ca06ec3d5034b2b257dab354e605486876e49d59
system.img bdd7ad34098daee47de44ec45d75487a316984efa5570525175b924dc77ce82c

# vendor: HALIUM_16 arm64-only.  Built by Volla for their MediaTek devices: it
# symlinks /vendor/lib64/hw/mapper.mediatek.so at the host Halium vendor
# (/vendor_extra), so the container's gralloc5 loads the phone's own MTK mapper
# and the A13-on-A14 skew that the binary patches and most of the gralloc
# bridge existed for is gone.
waydroid_arm64_only-vendor-20260908.zip 65695060df119f874f12cc331b55fc229eecc8889b2b47ff71e57bfb2995864d
vendor.img ec44a8a4e7df39fbfd75807be459cc9ad51d268ad7ab413419b68bbe4f4e95cb
