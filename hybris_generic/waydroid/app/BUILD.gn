#
# "Android Apps" — the OHOS front-end for the Waydroid container (W5).
# Pure-ArkUI launcher: no native module.  It is a launcher entry that, on
# fore/background, publishes SHOW/HIDE common events; the compositor
# subscribes and WaydroidSessionStub::ApplyVisibility shows+thaws or
# hides+freezes the container and moves the touch grab to match.  The
# container's pixels reach the panel via the compositor's self-drawing node
# (W3).  Because the HAP bundles no inner samgr/surface libs, none of the
# app-sandbox native-load / linker-namespace barriers apply (see README).
#
# OPT-IN like the rest of the container stack: only builds when
# persist.waydroid.enabled products want it (wired via the product
# bundle, same gate as waydroid_compositor).  X23 images are unaffected.

import("//build/ohos.gni")

ohos_hap("android_apps_hap") {
  hap_profile = "entry/src/main/module.json"
  hap_name = "AndroidApps"
  subsystem_name = "oniro_soc_products"
  part_name = "hybris_generic_soc"
  final_hap_path = "$root_out_dir/oniro_soc_products/hybris_generic_soc/AndroidApps.hap"
  deps = [
    ":android_apps_js_assets",
    ":android_apps_resources",
  ]
  certificate_profile = "signature/androidapps.p7b"
  module_install_dir = "app/org.oniroproject.androidapps"
}

ohos_app_scope("android_apps_app_profile") {
  app_profile = "AppScope/app.json"
  sources = [ "AppScope/resources" ]
}

ohos_js_assets("android_apps_js_assets") {
  ets2abc = true
  source_dir = "entry/src/main/ets"
}

ohos_resources("android_apps_resources") {
  sources = [ "entry/src/main/resources" ]
  deps = [ ":android_apps_app_profile" ]
  hap_profile = "entry/src/main/module.json"
}
