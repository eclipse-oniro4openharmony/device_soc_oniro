#
# waydroid_compositor — Wayland server + zero-copy gralloc bridge for the
# Android app container.  Plan: docs/hybris_generic/android_app_compat_plan.md
#
# The whole feature lives in this directory and is built only when the
# product sets hybris_generic_soc_feature_waydroid (waydroid.gni); the parent
# BUILD.gn does not even reference this file otherwise.  On an image that has
# it, nothing runs until persist.waydroid.enabled=1 (plan D10), so the X23 —
# same image, param never set — is unaffected.
#
# Split: every piece of code and configuration is installed by the targets
# below; /data/waydroid only ever holds the two pristine upstream images,
# data.img and runtime state.

import("//build/config/clang/clang.gni")
import("//build/ohos.gni")
import("//build/ohos/sa_profile/sa_profile.gni")
import("waydroid.gni")

assert(hybris_generic_soc_feature_waydroid,
       "waydroid/ is built only with hybris_generic_soc_feature_waydroid")

libhybris_root = "//third_party/libhybris"

config("waydroid_compositor_config") {
  include_dirs = [
    "binder",
    "include",
    "../hardware/display/include",

    # libhybris' server-side android_wlegl, and the Android headers its
    # public types (native_handle_t, ANativeWindowBuffer) come from
    "$libhybris_root/hybris/platforms/common",
    "$libhybris_root/hybris/include",
    "$libhybris_root/include",
    "//third_party/android-headers",
  ]

  cflags_cc = [
    "-std=c++17",
    "-Wno-unused-parameter",
  ]
}

ohos_executable("waydroid_compositor") {
  sources = [
    # libwdbinder: the libc-only binder client for the control plane.
    "binder/wdbinder.c",
    "src/waydroid_compositor_main.cpp",
    "src/waydroid_session.cpp",
    "src/waydroid_session_proxy.cpp",
    "src/wl_output_surface.cpp",
    "src/wl_server.cpp",
    "src/wlegl_import.cpp",

    # xdg-shell is generated as private-code (per upstream's
    # recommendation), so its interface symbols are not exported by
    # libwayland-server and each user compiles them in.
    "//third_party/wayland/generated/xdg-shell-protocol.c",
  ]

  configs = [ ":waydroid_compositor_config" ]

  # Same direct label the display buffer VDI uses for gralloc.
  deps = [ "$libhybris_root/hybris/gralloc:libgralloc" ]

  # Cross-part dependencies must go through external_deps (the build's
  # deps validator rejects a direct label into another part).
  external_deps = [
    "ability_base:want",
    "access_token:libaccesstoken_sdk",
    "access_token:libnativetoken_shared",
    "access_token:libtoken_setproc",
    "c_utils:utils",
    "common_event_service:cesfwk_innerkits",
    "graphic_2d:librender_service_base",
    "graphic_2d:librender_service_client",
    "graphic_surface:buffer_handle",
    "graphic_surface:surface",
    "graphic_surface:sync_fence",
    "hilog:libhilog",
    "init:libbeget_proxy",
    "init:libbegetutil",
    "input:libmmi-client",
    "ipc:ipc_core",
    "libhybris:libhybris-platformcommon",
    "samgr:samgr_proxy",
    "wayland:libwayland_server",
  ]

  install_enable = true
  part_name = "hybris_generic_soc"
  subsystem_name = "oniro_soc_products"
}

# Stands in for the container's hwcomposer: posts real gralloc buffers
# over android_wlegl so the frame path can be proven (and soaked) with
# no container running.  Ships with the image — it is a bring-up tool
# and costs a few KB.
ohos_executable("waydroid_wlegl_harness") {
  sources = [
    "test/wlegl_harness.cpp",

    # Both protocols are generated as private-code, so a client that
    # names their interfaces compiles them in (libhybris-platformcommon
    # has its own copy of the android one for the server side, but does
    # not export the symbols).
    "//third_party/wayland/generated/wayland-android-protocol.c",
    "//third_party/wayland/generated/xdg-shell-protocol.c",
  ]

  configs = [ ":waydroid_compositor_config" ]

  # Same direct label the display buffer VDI uses for gralloc.
  deps = [ "$libhybris_root/hybris/gralloc:libgralloc" ]

  external_deps = [
    "hilog:libhilog",
    "wayland:libwayland_client",
  ]

  install_enable = true
  part_name = "hybris_generic_soc"
  subsystem_name = "oniro_soc_products"
}

ohos_prebuilt_etc("waydroid_compositor_cfg") {
  source = "cfg/waydroid_compositor.cfg"
  relative_install_dir = "init"
  part_name = "hybris_generic_soc"
  subsystem_name = "oniro_soc_products"
}

# Start on demand.  The profile is all samgr needs to start the init service
# named by "process" when the front-end publishes its SHOW common event: no
# sa_main, no library ("libpath" is only there because the parser insists) —
# the supervisor launches waydroid_compositor, which registers SA 9601 itself.
# It is what lets an ordinary ArkTS app, with no native code and no permission
# to touch init, bring the stack up.
ohos_sa_profile("waydroid_sa_profile") {
  sources = [ "sa_profile/9601.json" ]
  part_name = "hybris_generic_soc"
}

# Auto-start + crash-recovery supervisor.  The init job above starts it on
# persist.waydroid.enabled=1; it launches a fresh compositor + container and
# relaunches the whole generation whenever the container dies.  Installed to
# /system/etc/waydroid/ and run via /system/bin/sh (the service reads it, so
# no exec bit is required).
ohos_prebuilt_etc("waydroid_supervisor_sh") {
  source = "cfg/waydroid-supervisor.sh"
  relative_install_dir = "waydroid"
  part_name = "hybris_generic_soc"
  subsystem_name = "oniro_soc_products"
}

# ── container launcher ─────────────────────────────────────────────────────
# Pure C, libc only.  In /system/bin rather than pushed to /data: it runs as
# root, so it must not live on a writable partition.
ohos_executable("waydroidd") {
  sources = [ "launcher/waydroidd.c" ]
  cflags = [
    "-Wall",
    "-Wextra",
    "-Wno-unused-parameter",
    "-O2",
  ]
  install_enable = true
  part_name = "hybris_generic_soc"
  subsystem_name = "oniro_soc_products"
}

# Root-shell front for libwdbinder: list/launch apps, properties, settings.
# Pure C, libc only.  Replaces the nsenter recipes.
ohos_executable("wdctl") {
  sources = [
    "binder/wdbinder.c",
    "binder/wdctl.c",
  ]
  cflags = [
    "-Wall",
    "-Wextra",
    "-O2",
  ]
  install_enable = true
  part_name = "hybris_generic_soc"
  subsystem_name = "oniro_soc_products"
}

# loopback -> container-veth TCP relay for the adb/scrcpy rig (W4).
ohos_executable("waydroid_tcprelay") {
  sources = [ "launcher/tcprelay.c" ]
  cflags = [
    "-Wall",
    "-Wextra",
    "-O2",
  ]
  install_enable = true
  part_name = "hybris_generic_soc"
  subsystem_name = "oniro_soc_products"
}

# ── /system/etc/waydroid: configuration the launcher reads ─────────────────
waydroid_etc_files = [
  "waydroid.prop",  # container properties (a /data copy overrides it)
  "hosthals.xml",  # trimmed host-HAL passthrough list (ditto)
  "images.manifest",  # sha256 pins of the upstream images, for provisioning
]
waydroid_etc_targets = []
foreach(f, waydroid_etc_files) {
  _t = "waydroid_etc_" + string_replace(f, ".", "_")
  ohos_prebuilt_etc(_t) {
    source = "data/$f"
    output = f
    relative_install_dir = "waydroid"
    part_name = "hybris_generic_soc"
    subsystem_name = "oniro_soc_products"
  }
  waydroid_etc_targets += [ ":$_t" ]
}

# ── /system/etc/waydroid/graft: what becomes the container's /odm ──────────
# The supervisor copies this tree to /data/waydroid/graft before every
# generation.  [ source, installed name, directory below waydroid/graft ].
waydroid_graft_files = [
  [
    "gralloc_bridge/start-allocator.sh",
    "start-allocator.sh",
    "",
  ],
  [
    "net/waydroid-net.sh",
    "waydroid-net.sh",
    "",
  ],
  [
    "gralloc_bridge/waydroid-gralloc.rc",
    "waydroid-gralloc.rc",
    "/etc/init",
  ],
  [
    "net/waydroid-net.rc",
    "waydroid-net.rc",
    "/etc/init",
  ],

  # The container's VINTF reads ODM manifest fragments from this exact name.
  [
    "gralloc_bridge/graphics-allocator-aidl.xml",
    "waydroid-allocator-aidl.xml",
    "/etc/vintf/manifest",
  ],

  # Once Android has booted: retire LineageOS' setup wizard (provision/).
  [
    "provision/waydroid-provision.rc",
    "waydroid-provision.rc",
    "/etc/init",
  ],

  # Static resource overlay: Android draws no status bar and no navigation
  # bar of its own — the OHOS ones stay.  Android scans /odm/overlay at boot.
  # Prebuilt, 3.6 KB, no code; sources and recipe in data/overlay/.
  [
    "data/overlay/OniroNoBars.apk",
    "OniroNoBars.apk",
    "/overlay",
  ],
]
waydroid_graft_targets = []
foreach(g, waydroid_graft_files) {
  _t = "waydroid_graft_" +
       string_replace(string_replace(g[1], ".", "_"), "-", "_")
  ohos_prebuilt_etc(_t) {
    source = g[0]
    output = "graft" + g[2] + "/" + g[1]
    relative_install_dir = "waydroid/graft" + g[2]
    part_name = "hybris_generic_soc"
    subsystem_name = "oniro_soc_products"
  }
  waydroid_graft_targets += [ ":$_t" ]
}

# The shell's native half: requireNapi('oniro.androidcontainer').  A SYSTEM
# NAPI module, because it needs the inner samgr/surface APIs that an app's
# linker namespace refuses to a library bundled in the HAP (see the source).
ohos_shared_library("androidcontainer") {
  sources = [
    "napi/android_container_napi.cpp",
    "src/waydroid_session_proxy.cpp",
  ]

  include_dirs = [ "include" ]

  cflags_cc = [ "-std=c++17" ]

  external_deps = [
    "c_utils:utils",
    "graphic_surface:surface",
    "hilog:libhilog",
    "ipc:ipc_core",
    "napi:ace_napi",
    "samgr:samgr_proxy",
  ]

  relative_install_dir = "module/oniro"
  part_name = "hybris_generic_soc"
  subsystem_name = "oniro_soc_products"
}

# W5 bring-up tool: stand-in for the Waydroid front-end — proves the
# cross-process surface handoff + touch/freeze IPC with no HAP in the loop.
ohos_executable("waydroid_session_test") {
  sources = [
    "src/waydroid_session_proxy.cpp",
    "test/session_test.cpp",
  ]

  include_dirs = [ "include" ]

  external_deps = [
    "c_utils:utils",
    "graphic_2d:librender_service_base",
    "graphic_2d:librender_service_client",
    "graphic_surface:surface",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]

  install_enable = true
  part_name = "hybris_generic_soc"
  subsystem_name = "oniro_soc_products"
}

group("waydroid_group") {
  deps = [
    ":androidcontainer",
    ":waydroid_compositor",
    ":waydroid_compositor_cfg",
    ":waydroid_sa_profile",
    ":waydroid_session_test",
    ":waydroid_supervisor_sh",
    ":waydroid_tcprelay",
    ":waydroid_wlegl_harness",
    ":waydroidd",
    ":wdctl",

    # The Waydroid shell: the grid, and one OHOS window per Android app
    # (app/README.md).  Its native half is :androidcontainer above.
    "app:android_apps_hap",
  ]
  deps += waydroid_etc_targets
  deps += waydroid_graft_targets
}
