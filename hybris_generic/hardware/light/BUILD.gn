import("//build/ohos.gni")

group("light_vdi_model") {
  deps = [ ":libhdi_light_impl" ]
}

# Replaces the stock HDF-kernel-backed VDI (drivers_peripheral_light
# hdi_impl) — the Halium kernels have no hdf_light driver. Loaded by
# liblight_interface_service via HdfLoadVdi from /vendor/lib64/. The stock
# impl is dropped with drivers_peripheral_light_feature_community = false in
# the product config.
ohos_shared_library("libhdi_light_impl") {
  sources = [ "src/hybris_light_vdi.cpp" ]

  include_dirs = [ "//drivers/peripheral/light/interfaces" ]

  external_deps = [
    "c_utils:utils",
    "hdf_core:libhdf_host",
    "hdf_core:libhdf_utils",
    "hilog:libhilog",
  ]

  cflags = [
    "-Wall",
    "-Wextra",
    "-Werror",
    "-fno-common",
    "-fno-strict-aliasing",
  ]

  install_enable = true
  install_images = [ chipset_base_dir ]
  output_name = "libhdi_light_impl"
  subsystem_name = "oniro_soc_products"
  part_name = "hybris_generic_soc"
}
