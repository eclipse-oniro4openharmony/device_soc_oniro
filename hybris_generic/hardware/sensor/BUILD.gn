import("//build/ohos.gni")

group("sensor_vdi_model") {
  deps = [ ":libhdi_sensor_impl" ]
}

# Replaces the stock HDF-kernel-backed VDI (drivers_peripheral_sensor
# hdi_impl) — the Halium kernel has no HDF sensor drivers; sensors come
# from the MTK sensorhub via /dev/hf_manager. Loaded by
# libsensor_interface_service via HdfLoadVdi from /vendor/lib64/.
ohos_shared_library("libhdi_sensor_impl") {
  sources = [ "src/hybris_sensor_vdi.cpp" ]

  include_dirs = [
    "//drivers/peripheral/sensor/interfaces/v1_0",
    "//drivers/peripheral/sensor/interfaces/include",
  ]

  external_deps = [
    "c_utils:utils",
    "drivers_interface_sensor:libsensor_stub_3.0",
    "hdf_core:libhdf_host",
    "hdf_core:libhdf_utils",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]

  cflags = [
    "-Wall",
    "-Wextra",
    "-Werror",
    "-fno-common",
    "-fno-strict-aliasing",
  ]

  install_enable = true
  install_images = [ chipset_base_dir ]
  output_name = "libhdi_sensor_impl"
  subsystem_name = "oniro_soc_products"
  part_name = "hybris_generic_soc"
}
